# mcp-toolkit 环境变量示例（复制为 .env 使用）
# 注意：.env 已被 .gitignore 排除，真实密钥永不入库

# —— tc3_sign 工具：默认密钥来源（也可通过工具入参显式传入）——
# 腾讯云 SecretId / SecretKey：控制台 → 访问管理 → API 密钥
# 占位值仅用于演示，真实密钥请填入本地 .env
TC3_SECRET_ID=AKID_REPLACE_ME
TC3_SECRET_KEY=REPLACE_ME
TC3_DEFAULT_SERVICE=sms
TC3_DEFAULT_HOST=sms.tencentcloudapi.com
TC3_DEFAULT_VERSION=2021-01-11

# —— 单元测试用：注入官方示例 SecretKey 以复现官方签名向量 ——
# TC3_SAMPLE_SECRET_KEY=<官方示例 SecretKey>
