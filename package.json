{
  "name": "mcp-toolkit",
  "version": "1.0.0",
  "description": "MCP 工具服务器：把分散的手写工具能力标准化为 8 个即插即用的 MCP 工具（热点排名 / TC3 签名 / 文本切块 / 日期计算 / SQLite 查询 / 网页抽取 / JWT 解码 / 健康检查）",
  "type": "module",
  "bin": {
    "mcp-toolkit": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "toolkit",
    "tc3",
    "signature",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
